# Variables de entorno — Veterinaria La Plata
# Copiá este archivo como .env y completá con tus credenciales

# Firebase Configuration
EXPO_PUBLIC_FIREBASE_API_KEY=your_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Demo mode: true habilita cuentas de prueba y fallbacks mock. En producción: false
EXPO_PUBLIC_DEMO_MODE=false

# Google Sign-In
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_web_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_ios_client_id.apps.googleusercontent.com

# Cloudinary (Unsigned upload preset — NO incluyas el API secret aquí)
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset

# Gemini (Chatbot)
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key

# Mercado Pago (opcional — para checkout)
EXPO_PUBLIC_MP_PUBLIC_KEY=your_mercadopago_public_key

# Sentry (opcional — para crash reporting)
SENTRY_DSN=your_sentry_dsn
