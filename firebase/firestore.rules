// ============================================================
// Veterinaria La Plata — Firestore Security Rules
// Role-based access control
// ============================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isRole(role) {
      return isAuthenticated() && getUserRole() == role;
    }

    function isAdmin() {
      return isRole('admin');
    }

    function isVet() {
      return isRole('vet');
    }

    function isGroomer() {
      return isRole('groomer');
    }

    function isReceptionist() {
      return isRole('receptionist');
    }

    function isClient() {
      return isRole('client');
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isStaff() {
      return isAdmin() || isVet() || isReceptionist() || isGroomer();
    }

    // --- Users Collection ---
    match /users/{userId} {
      // Un usuario solo puede crearse a sí mismo y siempre con rol 'client'
      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.role == 'client';
      allow read: if isOwner(userId) || isStaff();
      // El dueño puede actualizar su perfil pero nunca cambiar su rol
      allow update: if isAdmin()
        || (isOwner(userId)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'id', 'email']));
      allow delete: if isAdmin();
    }

    // --- Pets Collection ---
    match /pets/{petId} {
      allow read: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        isVet() || isAdmin() || isReceptionist() || isGroomer()
      );
      // Un cliente solo puede crear mascotas que le pertenezcan
      allow create: if isAuthenticated()
        && (request.resource.data.ownerId == request.auth.uid || isStaff());
      allow update: if isAuthenticated() && (
        (resource.data.ownerId == request.auth.uid &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['searchTokens', 'createdAt'])) ||
        isVet() || isAdmin()
      );
      allow delete: if isAdmin() || (
        isAuthenticated() && resource.data.ownerId == request.auth.uid
      );
    }

    // --- Appointments Collection ---
    match /appointments/{appointmentId} {
      allow read: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        isVet() || isAdmin() || isReceptionist() ||
        (isGroomer() && resource.data.type == 'grooming')
      );
      // El cliente solo puede crear turnos para mascotas propias
      allow create: if isAuthenticated() && (
        isStaff()
        || (isClient()
          && request.resource.data.ownerId == request.auth.uid
          && exists(/databases/$(database)/documents/pets/$(request.resource.data.petId))
          && get(/databases/$(database)/documents/pets/$(request.resource.data.petId)).data.ownerId == request.auth.uid)
      );
      allow update: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        isVet() || isAdmin() || isReceptionist()
      );
      allow delete: if isAdmin() || isReceptionist();
    }

    // --- Medical Records Collection ---
    // Only vets and admins can read/write. Clients can read their own pets' records.
    match /medicalRecords/{recordId} {
      allow read: if isAuthenticated() && (
        isVet() || isAdmin() ||
        exists(/databases/$(database)/documents/pets/$(resource.data.petId)) &&
        get(/databases/$(database)/documents/pets/$(resource.data.petId)).data.ownerId == request.auth.uid
      );
      allow create: if (isVet() || isAdmin())
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if (isVet() || isAdmin())
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if isAdmin();
    }

    // --- Grooming Records Collection ---
    match /groomingRecords/{recordId} {
      allow read: if isAuthenticated() && (
        isGroomer() || isVet() || isAdmin() ||
        exists(/databases/$(database)/documents/pets/$(resource.data.petId)) &&
        get(/databases/$(database)/documents/pets/$(resource.data.petId)).data.ownerId == request.auth.uid
      );
      allow create: if isGroomer() || isVet() || isAdmin();
      allow update: if isGroomer() || isVet() || isAdmin();
      allow delete: if isAdmin();
    }

    // --- Clinical Templates Collection ---
    // Solo staff puede leer; vet/admin escriben
    match /clinicalTemplates/{templateId} {
      allow read: if isStaff();
      allow create, update, delete: if isVet() || isAdmin();
    }

    // --- Prescriptions Collection ---
    match /prescriptions/{prescriptionId} {
      allow read: if isAuthenticated() && (
        isVet() || isAdmin() ||
        exists(/databases/$(database)/documents/pets/$(resource.data.petId)) &&
        get(/databases/$(database)/documents/pets/$(resource.data.petId)).data.ownerId == request.auth.uid
      );
      allow create: if isVet() || isAdmin();
      allow update: if isVet() || isAdmin();
      allow delete: if isAdmin();
    }

    // --- Follow-ups Collection ---
    match /followUps/{followUpId} {
      allow read: if isAuthenticated() && (
        isVet() || isAdmin() || isReceptionist()
      );
      allow create: if isVet() || isAdmin();
      allow update: if isVet() || isAdmin() || isReceptionist();
      allow delete: if isAdmin();
    }

    // --- Waiting Room Queue Collection ---
    match /waitingRoom/{queueItemId} {
      allow read: if isAuthenticated();
      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if isAdmin() || isReceptionist();
    }

    // --- Products Collection ---
    match /products/{productId} {
      allow read: if true; // Public catalog
      allow create, update: if isAdmin() || isReceptionist();
      allow delete: if isAdmin();
    }

    // --- Orders Collection ---
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (
        resource.data.clientId == request.auth.uid ||
        isAdmin() || isReceptionist()
      );
      // El cliente solo puede crear pedidos a su nombre
      allow create: if isAuthenticated()
        && (request.resource.data.clientId == request.auth.uid || isStaff());
      allow update: if isAuthenticated() && (
        resource.data.clientId == request.auth.uid ||
        isAdmin() || isReceptionist()
      );
      allow delete: if isAdmin();
    }

    // --- Notifications Collection ---
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid || isAdmin() || isVet() || isReceptionist()
      );
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // --- Campaigns Collection ---
    match /campaigns/{campaignId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // --- Admin Logs (auditoría) ---
    match /adminLogs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // --- Employees Collection ---
    match /employees/{employeeId} {
      allow read: if isStaff() || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // --- Veterinary Config (Singleton) ---
    match /veterinaryConfig/{configId} {
      allow read: if true; // Public info (hours, services)
      allow write: if isAdmin();
    }

    // --- Coupons Collection ---
    match /coupons/{couponId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin() || isReceptionist();
    }
  }
}
