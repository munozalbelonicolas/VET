rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // User avatars: el usuario solo escribe su propia carpeta
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Pet photos: el dueño de la mascota o staff
    match /pets/{petId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Product images (admin/receptionist only)
    match /products/{productId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Medical attachments (vets and admins)
    match /medical/{recordId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Transfer receipts
    match /receipts/{orderId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
